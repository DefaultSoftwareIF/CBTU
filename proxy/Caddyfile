# HTTPS é obrigatório: sem ele o navegador não registra o service worker e o PWA não funciona offline.
# Os certificados vêm da CA interna da empresa (pasta ./certs, montada em /certs).
{$SITE_ADDRESS} {
	tls /certs/server.crt /certs/server.key
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}

	# O service worker e o manifest nunca podem ficar no cache do navegador;
	# senão as versões novas do app não chegam aos aparelhos.
	@semcache path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @semcache Cache-Control "no-cache"

	# Arquivos com hash no nome podem ser guardados por muito tempo.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
