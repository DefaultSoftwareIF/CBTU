# Copie para .env e troque os valores. Nunca versione o .env.
# Se a senha tiver caracteres especiais (@ : / ?), prefira uma senha só com letras e números
# (ela entra na URL de conexão do MongoDB).
MONGO_USER=rodatrack
MONGO_PASSWORD=troque-esta-senha

# Nome interno pelo qual os aparelhos acessam o app (precisa bater com o certificado em ./certs).
SITE_ADDRESS=rodatrack.intranet.local
